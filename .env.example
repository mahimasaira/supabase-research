# Values from `npx supabase status` (local) or the dashboard (hosted).
VITE_SUPABASE_URL=http://127.0.0.1:54321
# The anon / publishable key. NEVER put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=

# Spam protection (feature 3): Cloudflare Turnstile SITE key (public). Default in the code is
# Cloudflare's always-passing TEST site key. The SECRET key never goes here: see npm run probe:spam:setup.
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
