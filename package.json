{
  "name": "supabase-booking",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "functions:serve": "supabase functions serve",
    "test:rls": "node --env-file=.env.local scripts/test-rls.mjs",
    "probe:recurring:seed": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -v ON_ERROR_STOP=1 -f src/probes/recurring/sql/seed.sql",
    "probe:recurring:edge-proof": "node --env-file=.env.local src/probes/recurring/edge-proof.mjs",
    "probe:audit:seed": "npm run -s probe:recurring:seed && psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -v ON_ERROR_STOP=1 -f src/probes/audit/sql/seed.sql",
    "probe:audit:proof": "node --env-file=.env.local src/probes/audit/proof.mjs",
    "probe:audit:proof:triggers": "node --env-file=.env.local src/probes/audit/proof-triggers.mjs",
    "probe:audit:compare": "node --env-file=.env.local src/probes/audit/compare-tools.mjs",
    "probe:audit:proof:history": "node --env-file=.env.local src/probes/audit/proof-history.mjs",
    "probe:docusign:proof:pending": "node --env-file=.env.local src/probes/docusign/proof-pending.mjs",
    "probe:docusign:setup": "node --env-file=.env.local src/probes/docusign/setup-local.mjs",
    "probe:docusign:proof:send": "node --env-file=.env.local src/probes/docusign/proof-send.mjs",
    "probe:docusign:proof:receive": "node --env-file=.env.local src/probes/docusign/proof-receive.mjs",
    "probe:docusign:proof:failures": "node --env-file=.env.local src/probes/docusign/proof-failures.mjs",
    "probe:spam:seed": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -q -v ON_ERROR_STOP=1 -f src/probes/spam/sql/seed.sql",
    "probe:spam:flood": "node --env-file=.env.local src/probes/spam/flood.mjs",
    "evidence": "node scripts/evidence.mjs",
    "test:clean": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -c \"delete from auth.users where email like '%@test.dev'\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
